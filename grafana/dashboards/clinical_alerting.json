{
  "title": "Clinical Alerting System",
  "uid": "clinical-alerting",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "tags": ["clinical", "alerting"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Vitals / sec",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 300 }
          ]}
        }
      },
      "targets": [{ "expr": "sum(rate(vitals_ingested_total[1m]))", "refId": "A", "legendFormat": "readings/s" }],
      "datasource": "Prometheus"
    },
    {
      "id": 2, "type": "stat", "title": "Triage Events / sec",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
          ]}
        }
      },
      "targets": [{ "expr": "sum(rate(triage_dispatched_total[1m]))", "refId": "A", "legendFormat": "events/s" }],
      "datasource": "Prometheus"
    },
    {
      "id": 3, "type": "stat", "title": "AI Inference p95",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 15 },
            { "color": "red", "value": 30 }
          ]}
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(ai_inference_duration_seconds_bucket[5m])) by (le))",
        "refId": "A", "legendFormat": "p95"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 4, "type": "stat", "title": "Suppression Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.7 }
          ]}
        }
      },
      "targets": [{
        "expr": "sum(alerts_total{outcome='suppressed'}) / sum(alerts_total)",
        "refId": "A", "legendFormat": "suppression rate"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 5, "type": "stat", "title": "DLQ Messages",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]}
        }
      },
      "targets": [{ "expr": "sum(dlq_messages_total)", "refId": "A", "legendFormat": "total" }],
      "datasource": "Prometheus"
    },
    {
      "id": 6, "type": "stat", "title": "Active WS Connections",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]}
        }
      },
      "targets": [{ "expr": "ws_connections_active", "refId": "A", "legendFormat": "connections" }],
      "datasource": "Prometheus"
    },
    {
      "id": 7, "type": "timeseries", "title": "Vitals Ingestion Rate",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "expr": "sum(rate(vitals_ingested_total[1m])) by (patient_id)",
        "refId": "A", "legendFormat": "{{patient_id}}"
      }],
      "datasource": "Prometheus"
    },
    {
      "id": 8, "type": "timeseries", "title": "AI Inference Latency",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_inference_duration_seconds_bucket[2m])) by (le))",
          "refId": "A", "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ai_inference_duration_seconds_bucket[2m])) by (le))",
          "refId": "B", "legendFormat": "p50"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 9, "type": "timeseries", "title": "Alert Outcomes",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [
        {
          "expr": "rate(alerts_total{outcome='critical'}[2m])",
          "refId": "A", "legendFormat": "critical"
        },
        {
          "expr": "rate(alerts_total{outcome='suppressed'}[2m])",
          "refId": "B", "legendFormat": "suppressed"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "id": 10, "type": "timeseries", "title": "Triage Dispatch Rate",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      },
      "targets": [{
        "expr": "rate(triage_dispatched_total[1m])",
        "refId": "A", "legendFormat": "triage events/s"
      }],
      "datasource": "Prometheus"
    }
  ]
}
